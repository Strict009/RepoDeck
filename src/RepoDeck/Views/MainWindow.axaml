<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RepoDeck.ViewModels"
        xmlns:controls="using:RepoDeck.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="RepoDeck.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RepoDeck"
        Icon="avares://RepoDeck/Assets/RepoDeck.ico"
        Width="1320" Height="860"
        MinWidth="720" MinHeight="600"
        Background="{DynamicResource RdPageBackgroundBrush}">

    <Window.Styles>
        <!--
            One responsive state, and only one. Below the threshold the sidebar becomes an
            icon rail: the same list, the same commands, the same selection and the same
            keyboard behaviour, with the labels hidden and the tooltips doing their work.
            No drawer, no overlay, no breakpoint framework.
        -->
        <Style Selector="Border.sidebar">
            <Setter Property="Width" Value="232" />
        </Style>

        <Style Selector="Grid.compact Border.sidebar">
            <Setter Property="Width" Value="64" />
        </Style>

        <Style Selector="Grid.compact StackPanel.wordmark">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Grid.compact TextBlock.navLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Grid.compact Border.systemPanel">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Centre the icons once the labels have gone. The horizontal inset goes, the
             vertical rhythm stays: five icons stacked with no breathing room between them
             read as one object rather than five destinations. -->
        <Style Selector="Grid.compact ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="0,11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Panel>

    <!--
        The first-run welcome takes the whole window. A welcome competing with the
        interface it is introducing helps nobody.
    -->
    <ContentControl Content="{Binding Onboarding}"
                    IsVisible="{Binding ShowOnboarding}" />

    <Grid Name="ShellGrid" ColumnDefinitions="Auto,*" IsVisible="{Binding ShowShell}">

        <!-- ==================== Control strip ==================== -->
        <Border Grid.Column="0"
                Classes="sidebar"
                Background="{DynamicResource RdSidebarBrush}"
                BorderBrush="{DynamicResource RdBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Wordmark: a lime bar and the name.
                     The READY pill that used to sit here is gone. It was directly under the
                     wordmark, said READY almost always, and the status strip at the foot of
                     the window says the same thing. A permanent indicator that nothing is
                     wrong is furniture. -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource RdBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,20,18,16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="4" Height="26"
                                Background="{DynamicResource RdAccentBrush}"
                                CornerRadius="{DynamicResource RdRadiusSharp}" />
                        <StackPanel Classes="wordmark" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="RepoDeck" FontSize="20" FontWeight="Bold"
                                       LetterSpacing="0.4" />
                            <TextBlock Text="GITHUB, MADE APPROACHABLE"
                                       Classes="microLabel" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1"
                         Name="NavigationList"
                         Tapped="OnNavigationTapped"
                         Classes="nav"
                         Margin="0,10,0,0"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <!-- The tooltip and the accessible name are always set, not only
                                 in the rail: when the label is hidden they are the only way
                                 to know what this is, and a name that appears conditionally
                                 is a name a screen reader cannot rely on. -->
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        ToolTip.Tip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}">
                                <Path Data="{Binding Icon}"
                                      Fill="{Binding $parent[ListBoxItem].Foreground}"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           Classes="navLabel"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding $parent[ListBoxItem].Foreground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--
                    The sidebar foot, which now appears only when something is wrong.

                    It used to carry a SYSTEM heading, a connection light, a fourteen-segment
                    allowance meter reading ALLOWANCE OK, and the machine's architecture -
                    permanently, below the navigation, for somebody who came here to find
                    software. All of it is still in Settings and in the diagnostic report,
                    where troubleshooting belongs. What survives here is the part that is
                    genuinely urgent: the allowance running out, or GitHub being unreachable.
                -->
                <Border Grid.Row="2"
                        Classes="systemPanel"
                        BorderBrush="{DynamicResource RdBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,14,14,16"
                        IsVisible="{Binding ShowSystemPanel}">
                    <StackPanel Spacing="9">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding ShowConnectionProblem}">
                            <Ellipse Classes="led ledWarn" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionText}" Classes="muted"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding AllowanceNeedsAttention}"
                                    ToolTip.Tip="{Binding RateLimitDetail}">
                            <TextBlock Text="{Binding RateLimitLabel}" Classes="muted" />
                            <controls:SegmentedMeter Height="6" SegmentCount="14"
                                                     Value="{Binding RateLimitPercent}"
                                                     OnBrush="{DynamicResource RdCautionBrush}"
                                                     OffBrush="{DynamicResource RdPanelInsetBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Content ==================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0"
                    Padding="28,16,28,0"
                    IsVisible="{Binding CanGoBack}">
                <Button Classes="link"
                        Command="{Binding GoBackCommand}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                              Fill="{DynamicResource RdAccentBrush}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold" LetterSpacing="0.8"
                                   Foreground="{DynamicResource RdAccentBrush}" />
                    </StackPanel>
                </Button>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

            <!-- Status strip, in the manner of a classic desktop application -->
            <Border Grid.Row="2"
                    Background="{DynamicResource RdSidebarBrush}"
                    BorderBrush="{DynamicResource RdBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,7">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="led"
                                 Classes.ledOn="{Binding IsReady}"
                                 Classes.ledWarn="{Binding IsBusy}" />
                        <TextBlock Text="{Binding ActivityText}" Classes="microLabel"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted"
                               Margin="18,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="2" Text="{Binding LibraryText}" Classes="muted"
                               Margin="0,0,18,0" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding RateLimitText}" Classes="muted"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding RateLimitDetail}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Panel>
</Window>
