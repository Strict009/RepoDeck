<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="360"
             x:Class="RepoDeck.Views.RepositoryCardView"
             x:DataType="vm:RepositoryCardViewModel"
             Width="320">

    <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ==================== Media ==================== -->
            <Panel Grid.Row="0" Height="150" ClipToBounds="True">

                <!--
                    The designed fallback. Never a broken-image icon: a coloured field
                    derived from the project name, a faint grid, and the initial. A page
                    of results with no screenshots still looks deliberate.
                -->
                <Panel IsVisible="{Binding ShowFallback}">
                    <Border Background="{Binding FallbackBrush}" />

                    <!-- A faint grid, in the manner of a utility's backdrop -->
                    <Border Opacity="0.14">
                        <Border.Background>
                            <VisualBrush TileMode="Tile"
                                         SourceRect="0,0,16,16"
                                         DestinationRect="0,0,16,16">
                                <VisualBrush.Visual>
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Width="16" Height="1" Fill="{DynamicResource RdGridLineBrush}" />
                                        <Rectangle Width="1" Height="16" Fill="{DynamicResource RdGridLineBrush}" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="{Binding FallbackInitial}"
                               FontSize="54" FontWeight="Bold"
                               Foreground="{DynamicResource RdOnAccentBrush}"
                               Opacity="0.82"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Panel>

                <Image Source="{Binding Image}"
                       IsVisible="{Binding ShowImage}"
                       Stretch="UniformToFill"
                       StretchDirection="Both" />

                <!-- Setup level sits on the image, where the eye already is -->
                <Border Classes="chip chipAccent"
                        IsVisible="{Binding ShowSetupLabel}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="10"
                        ToolTip.Tip="{Binding VerdictExplanation}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="led ledOn" Width="6" Height="6" />
                        <TextBlock Text="{Binding SetupLabel}" />
                    </StackPanel>
                </Border>

                <Border Classes="chip chipCaution"
                        IsVisible="{Binding IsArchived}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="10">
                    <TextBlock Text="ABANDONED" />
                </Border>
            </Panel>

            <!-- ==================== Body ==================== -->
            <StackPanel Grid.Row="1" Margin="16,14,16,10" Spacing="8">
                <TextBlock Text="{Binding FriendlyName}" Classes="h1"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />

                <TextBlock Text="{Binding Purpose}"
                           Classes="secondary"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"
                           Height="57" />

                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding HasPlatformText}">
                    <TextBlock Text="{Binding PlatformText}" Classes="microLabel"
                               Foreground="{DynamicResource RdTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ==================== Actions and small print ==================== -->
            <StackPanel Grid.Row="2">
                <Border BorderBrush="{DynamicResource RdBorderBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource RdSurfaceAltBrush}"
                        Padding="16,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" ItemSpacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Owner}" Classes="muted"
                                       TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            <TextBlock Text="{Binding LanguageText}" Classes="muted"
                                       IsVisible="{Binding HasLanguage}" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="link" Content="GITHUB"
                                    Command="{Binding OpenOnGitHubCommand}"
                                    ToolTip.Tip="Open this project's page on GitHub" />
                            <Button Classes="primary" Content="DETAILS"
                                    Command="{Binding OpenDetailsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
