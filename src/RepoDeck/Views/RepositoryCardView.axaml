<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="400"
             x:Class="RepoDeck.Views.RepositoryCardView"
             x:DataType="vm:RepositoryCardViewModel">

    <!--
        Read in the order someone deciding what to install actually reads: the name, a
        picture of it, what it is for, where it runs, how much work it is, what RepoDeck
        can do about it, the action. The owner slug and the language are last and small.
    -->
    <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

            <!-- ============ 1. The name, in a title bar ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource RdSurfaceAltBrush}"
                    BorderBrush="{DynamicResource RdBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0"
                            Width="3" Height="16"
                            Background="{DynamicResource RdAccentBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding FriendlyName}"
                               Classes="h1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Border Classes="chip chipCaution"
                                IsVisible="{Binding IsArchived}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="The authors have stopped maintaining this project.">
                            <TextBlock Text="ABANDONED" />
                        </Border>

                        <!-- A bookmark, not a rating. Independent of whether it is installed. -->
                        <Button Classes="star"
                                Classes.starOn="{Binding IsFavorite}"
                                Content="{Binding FavoriteGlyph}"
                                Command="{Binding ToggleFavoriteCommand}"
                                ToolTip.Tip="{Binding FavoriteTooltip}"
                                AutomationProperties.Name="{Binding FavoriteTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 2. The picture ============ -->
            <Panel Grid.Row="1" Height="164" ClipToBounds="True">

                <!--
                    RepoDeck's own artwork, drawn for the kind of thing this appears to be.
                    Never GitHub's generated preview card - that is the project name and
                    description set in small type, unreadable at this size and dishonest
                    presented as a picture. Never a fabricated screenshot or logo either:
                    these are plain geometric marks, the same for every project of a kind,
                    and the caption says which kind rather than implying the project drew it.
                -->
                <Panel IsVisible="{Binding ShowFallback}">
                    <Border Background="{Binding FallbackBrush}" />

                    <controls:KindArtwork Kind="{Binding Kind}"
                                          Initial="{Binding FallbackInitial}"
                                          Accent="{DynamicResource RdOnAccentBrush}"
                                          Opacity="0.8" />

                    <Border Classes="chip"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="10"
                            ToolTip.Tip="{Binding KindExplanation}">
                        <TextBlock Text="{Binding FallbackCaption}" />
                    </Border>
                </Panel>

                <Image Source="{Binding Image}"
                       IsVisible="{Binding ShowImage}"
                       Stretch="UniformToFill"
                       StretchDirection="Both" />
            </Panel>

            <!-- ============ 3. What it is for ============ -->
            <StackPanel Grid.Row="2" Margin="16,14,16,8" Spacing="10">
                <TextBlock Text="{Binding Purpose}"
                           Classes="secondary"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis"
                           MinHeight="58"
                           VerticalAlignment="Top" />

                <!-- ============ 4. Where it runs ============ -->
                <StackPanel Orientation="Horizontal" Spacing="7"
                            IsVisible="{Binding HasPlatformText}">
                    <Ellipse Classes="led ledOff" Width="6" Height="6" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlatformText}" Classes="microLabel"
                               Foreground="{DynamicResource RdTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- ============ 5 and 6. Effort, and what RepoDeck can do ============ -->
            <Border Grid.Row="3" Classes="inset" Margin="16,0,16,12" Padding="12,9">
                <StackPanel Spacing="8">

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding ShowSetupLabel}"
                                ToolTip.Tip="{Binding SetupExplanation}">
                        <TextBlock Text="SETUP" Classes="microLabel" Width="74"
                                   TextWrapping="NoWrap" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SetupLabel}" Classes="secondary"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- The REPODECK row label is gone: the whole window is RepoDeck, and
                         repeating it once per card said nothing thirty times. What the
                         verdict is stays, in a pill that always carries its own words. -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                ToolTip.Tip="{Binding InstallabilityExplanation}">
                        <TextBlock Text="CAN INSTALL" Classes="microLabel" Width="74"
                                   TextWrapping="NoWrap" VerticalAlignment="Center" />
                        <Border Classes="statusPill"
                                Classes.positive="{Binding IsReadyToInstall}"
                                Classes.caution="{Binding IsDeveloperFocused}"
                                Classes.danger="{Binding IsNotCompatible}"
                                Classes.neutral="{Binding !IsInstallabilityKnown}">
                            <TextBlock Text="{Binding InstallabilityLabel}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The classification is inspectable without filling every card with prose. -->
            <Expander Grid.Row="4"
                      Header="WHY?"
                      IsExpanded="{Binding IsWhyExpanded}"
                      Margin="16,0,16,10">
                <StackPanel Spacing="7" Margin="0,7,0,2">
                    <TextBlock Text="{Binding WhyHeading}" Classes="microLabel"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WhyReasons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="•" Classes="muted"
                                               Margin="0,0,7,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- ============ 7 and 8. The action, then the small print ============ -->
            <Border Grid.Row="5"
                    BorderBrush="{DynamicResource RdBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource RdSurfaceAltBrush}"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding MetadataLine}"
                               Classes="muted"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Who publishes this, and what it is written in" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="quiet" Content="SOURCE"
                                Command="{Binding OpenOnGitHubCommand}"
                                ToolTip.Tip="Open this project's source code on GitHub" />

                        <Button Classes="primary"
                                Content="{Binding PrimaryActionLabel}"
                                Command="{Binding ActivateCommand}"
                                ToolTip.Tip="{Binding PrimaryActionTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
