<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="300"
             x:Class="RepoDeck.Views.RepositoryCardView"
             x:DataType="vm:RepositoryCardViewModel">

    <!--
        A search result, read in the order somebody deciding actually reads it: what it is
        called and who makes it, what it is for, what RepoDeck knows about running it, then
        the one thing worth doing about it. Evidence sits underneath, folded away.

        The banner is gone. It was 164px of artwork on a 460px card, and for the common case
        - a project with no usable image - it drew the same geometric mark on every card in
        the row, so three results were distinguished only by hue. Identity is now a 56px tile
        beside the name, which is what it was doing anyway.
    -->
    <Border Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!-- ============ 1. Identity: icon, name, publisher ============ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,16,16,12">

                <!--
                    RepoDeck's own artwork, drawn for the kind of thing this appears to be.
                    Never GitHub's generated preview card, and never a fabricated screenshot
                    or logo: these are plain geometric marks, the same for every project of a
                    kind, and the tooltip says which kind rather than implying the project
                    drew it.
                -->
                <Border Grid.Column="0" Width="56" Height="56"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource RdRadiusMedium}"
                        Margin="0,0,14,0"
                        ToolTip.Tip="{Binding KindExplanation}">
                    <Panel>
                        <Border Background="{Binding FallbackBrush}"
                                IsVisible="{Binding ShowFallback}" />
                        <controls:KindArtwork Kind="{Binding Kind}"
                                              Initial="{Binding FallbackInitial}"
                                              Accent="{DynamicResource RdOnAccentBrush}"
                                              MarkScale="0.62"
                                              Opacity="0.85"
                                              IsVisible="{Binding ShowFallback}" />
                        <Image Source="{Binding Image}"
                               IsVisible="{Binding ShowImage}"
                               Stretch="UniformToFill" />
                    </Panel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <!-- The full name is on the tooltip, because a long one is trimmed. -->
                    <TextBlock Text="{Binding FriendlyName}"
                               Classes="cardTitle"
                               ToolTip.Tip="{Binding FriendlyName}"
                               AutomationProperties.Name="{Binding FriendlyName}" />

                    <!-- Who publishes it. The implementation language is not part of who
                         somebody is, and it moved to the technical details. -->
                    <TextBlock Text="{Binding Owner}" Classes="muted"
                               TextTrimming="CharacterEllipsis" MaxLines="1"
                               ToolTip.Tip="Who publishes this" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top">
                    <!-- A bookmark, not a rating. Independent of whether it is installed. -->
                    <Button Classes="star"
                            Classes.starOn="{Binding IsFavorite}"
                            Content="{Binding FavoriteGlyph}"
                            Command="{Binding ToggleFavoriteCommand}"
                            ToolTip.Tip="{Binding FavoriteTooltip}"
                            AutomationProperties.Name="{Binding FavoriteTooltip}" />
                </StackPanel>
            </Grid>

            <!-- ============ 2. What it is for ============ -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Purpose}"
                       Classes="secondary"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       MinHeight="36"
                       Margin="16,0,16,12" />

            <!-- ============ 3. Status ============
                 Three short facts at most, in place of the labelled mini-table that used to
                 repeat SETUP and CAN INSTALL on every card. Each is a pill carrying its own
                 words, so none of them depends on colour to be understood.
            -->
            <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"
                       Margin="16,0,16,12">

                <!-- What the project says about where it runs. Neutral, always: this is the
                     project's own claim from its tags, not RepoDeck checking anything, and
                     dressing it as a verdict would imply a compatibility answer nobody has
                     worked out yet. -->
                <Border Classes="statusPill neutral"
                        IsVisible="{Binding HasPlatformText}"
                        ToolTip.Tip="What the project says about where it runs. RepoDeck has not checked this.">
                    <TextBlock Text="{Binding PlatformText}" />
                </Border>

                <Border Classes="statusPill"
                        Classes.positive="{Binding SetupIsPositive}"
                        Classes.caution="{Binding SetupIsCaution}"
                        Classes.neutral="{Binding SetupIsNeutral}"
                        IsVisible="{Binding ShowSetupLabel}"
                        ToolTip.Tip="{Binding SetupExplanation}">
                    <TextBlock Text="{Binding SetupLabel}" />
                </Border>

                <!-- Hidden when the action already says it: an accent INSTALL beside a pill
                     reading "Ready to install" is the same sentence twice. -->
                <Border Classes="statusPill"
                        Classes.positive="{Binding InstallabilityIsPositive}"
                        Classes.caution="{Binding InstallabilityIsCaution}"
                        Classes.danger="{Binding InstallabilityIsDanger}"
                        Classes.neutral="{Binding InstallabilityIsNeutral}"
                        IsVisible="{Binding ShowInstallabilityPill}"
                        ToolTip.Tip="{Binding InstallabilityExplanation}">
                    <TextBlock Text="{Binding InstallabilityPillText}" />
                </Border>

                <Border Classes="statusPill caution"
                        IsVisible="{Binding IsArchived}"
                        ToolTip.Tip="The authors have stopped maintaining this project.">
                    <TextBlock Text="Abandoned" />
                </Border>
            </WrapPanel>

            <!-- ============ 4. Evidence, folded away ============
                 A quiet disclosure rather than something styled like an action. The heading
                 names the question it answers, because Quick Look asks a different one.
            -->
            <Expander Grid.Row="3"
                      Classes="evidence"
                      Header="Why this match"
                      IsExpanded="{Binding IsWhyExpanded}"
                      Margin="16,0,16,12">
                <StackPanel Spacing="7" Margin="0,7,0,2">
                    <TextBlock Text="{Binding WhyHeading}" Classes="microLabel"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding WhyReasons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="•" Classes="muted"
                                               Margin="0,0,7,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- ============ 5. The action ============
                 One dominant action at most. INSTALL earns the accent because something can
                 actually happen; DETAILS is quiet, because "read more about it" is not worth
                 the brightest thing on the page thirty times over. SOURCE is a link.
            -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource RdBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource RdSurfaceAltBrush}"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" Classes="link" Content="SOURCE"
                            Command="{Binding OpenOnGitHubCommand}"
                            ToolTip.Tip="Open this project's source code on GitHub"
                            AutomationProperties.Name="Open this project's source code on GitHub" />

                    <!-- Exactly one of these classes applies. Setting both a static class
                         and a conditional one would leave the winner to style order. -->
                    <Button Grid.Column="2"
                            Classes.primary="{Binding CanInstallDirectly}"
                            Classes.secondary="{Binding !CanInstallDirectly}"
                            Content="{Binding PrimaryActionLabel}"
                            Command="{Binding ActivateCommand}"
                            ToolTip.Tip="{Binding PrimaryActionTooltip}"
                            AutomationProperties.Name="{Binding PrimaryActionTooltip}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
