<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             xmlns:views="using:RepoDeck.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RepoDeck.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28,22,28,0">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Downloads" Classes="display" />
            <TextBlock Classes="secondary"
                       Text="Files RepoDeck fetched but could not turn into a working program" />
            <TextBlock Classes="muted"
                       Text="RepoDeck will not run any of these for you. Open the folder and decide for yourself." />
            <TextBlock Text="{Binding Message}" Classes="muted"
                       IsVisible="{Binding HasMessage}" Margin="0,6,0,0" />
        </StackPanel>

        <views:EmptyStateView Grid.Row="1"
                              IsVisible="{Binding ShowEmptyState}"
                              Title="Nothing here"
                              Message="When RepoDeck downloads something it cannot install - a Windows installer, a system package, or an archive with no program inside - it is kept here rather than pretended to be installed." />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding ShowAnything}">
            <StackPanel Spacing="20" Margin="0,0,14,20">

                <!-- ==================== Happening now ==================== -->
                <StackPanel Spacing="10" IsVisible="{Binding ShowActive}">
                    <TextBlock Text="HAPPENING NOW" Classes="sectionLabel" />

                    <ItemsControl ItemsSource="{Binding Active}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferViewModel">
                                <Border Classes="card" Padding="14" Margin="0,0,0,10">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Ellipse Grid.Column="0" Classes="led ledWarn"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock Text="{Binding Name}" Classes="body"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding VersionText}" Classes="muted"
                                                               IsVisible="{Binding HasVersion}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding AssetText}" Classes="muted"
                                                           IsVisible="{Binding HasAsset}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                       Classes="microLabel"
                                                       Foreground="{DynamicResource RdAccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <controls:SegmentedMeter Height="12" SegmentCount="28"
                                                                 Value="{Binding Percent}"
                                                                 IsVisible="{Binding HasKnownSize}"
                                                                 OnBrush="{DynamicResource RdAccentBrush}"
                                                                 OffBrush="{DynamicResource RdPanelInsetBrush}" />

                                        <ProgressBar Height="6" IsIndeterminate="True"
                                                     IsVisible="{Binding !HasKnownSize}" />

                                        <TextBlock Text="{Binding BytesText}" Classes="muted"
                                                   IsVisible="{Binding HasBytes}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ==================== Recently ==================== -->
                <StackPanel Spacing="10" IsVisible="{Binding ShowFinished}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="RECENTLY" Classes="sectionLabel"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="quiet" Content="CLEAR"
                                Command="{Binding ClearFinishedCommand}"
                                ToolTip.Tip="Forget these records. Nothing is deleted from your computer." />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Finished}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferViewModel">
                                <Border Classes="card" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Ellipse Grid.Column="0" Classes="led"
                                                 Classes.ledOn="{Binding IsCompleted}"
                                                 Classes.ledBad="{Binding IsFailed}"
                                                 Classes.ledOff="{Binding IsCancelled}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <TextBlock Text="{Binding Name}" Classes="body"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding VersionText}" Classes="muted"
                                                           IsVisible="{Binding HasVersion}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Classes="muted"
                                                       IsVisible="{Binding HasMessage}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="1" Margin="14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" Classes="microLabel" />
                                            <TextBlock Text="{Binding WhenText}" Classes="muted" />
                                        </StackPanel>

                                        <Button Grid.Column="3" Classes="quiet" Content="FORGET"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanForget}"
                                                Command="{Binding ForgetCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ==================== Kept files ==================== -->
                <StackPanel Spacing="10" IsVisible="{Binding ShowList}">
                    <TextBlock Text="FILES REPODECK KEPT" Classes="sectionLabel" />

                    <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadedAssetViewModel">
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel Spacing="0">

                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" Classes="h1" />
                                        <Border Classes="chip" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReleaseText}" />
                                        </Border>
                                        <Border Classes="chip chipCaution" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Owner}" Classes="muted" />
                                </StackPanel>

                                <TextBlock Text="{Binding AssetText}" Classes="body" Margin="0,12,0,0" />

                                <WrapPanel ItemSpacing="18" LineSpacing="6" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SizeText}" Classes="muted" />
                                    <TextBlock Text="{Binding DownloadedText}" Classes="muted" />
                                </WrapPanel>

                                <!-- Why this is not an installation, stated plainly -->
                                <Border Background="{DynamicResource RdSurfaceAltBrush}"
                                        CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding ReasonText}" Classes="secondary" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                                    <Button Classes="secondary" Content="OPEN FOLDER"
                                            Command="{Binding OpenFolderCommand}" />
                                    <Button Classes="secondary" Content="GITHUB"
                                            Command="{Binding ViewRepositoryCommand}" />
                                    <Button Classes="danger" Content="REMOVE"
                                            IsVisible="{Binding ShowForgetButton}"
                                            Command="{Binding BeginForgetCommand}" />
                                </StackPanel>

                                <Border Background="{DynamicResource RdDangerSoftBrush}"
                                        CornerRadius="10" Padding="14" Margin="0,12,0,0"
                                        IsVisible="{Binding IsConfirmingForget}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="body"
                                                   Text="Delete this downloaded file and forget it?" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="danger" Content="DELETE IT"
                                                    Command="{Binding ConfirmForgetCommand}" />
                                            <Button Classes="secondary" Content="KEEP IT"
                                                    Command="{Binding CancelForgetCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
