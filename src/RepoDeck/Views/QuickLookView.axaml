<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="720"
             x:Class="RepoDeck.Views.QuickLookView"
             x:DataType="vm:QuickLookViewModel">

    <!--
        The side panel. The top of it is the five things somebody deciding needs - what it
        is called, what it does, whether it runs here, how much work it is, what it costs
        to download - and the button. Everything RepoDeck reasoned from sits one disclosure
        below, in full.
    -->
    <Border Background="{DynamicResource RdSidebarBrush}"
            BorderBrush="{DynamicResource RdBorderBrush}"
            BorderThickness="1,0,0,0">

        <Grid RowDefinitions="Auto,*">

            <!-- ==================== 1. The name ==================== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource RdSurfaceAltBrush}"
                    BorderBrush="{DynamicResource RdBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="QUICK LOOK" Classes="microLabel"
                                   Foreground="{DynamicResource RdAccentBrush}" />
                        <TextBlock Text="{Binding Title}" Classes="h1"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{Binding Subtitle}" Classes="muted"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>

                    <Button Grid.Column="1" Classes="quiet" Content="CLOSE"
                            VerticalAlignment="Top"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close this panel" />
                </Grid>
            </Border>

            <!-- ==================== Working ==================== -->
            <StackPanel Grid.Row="1" Spacing="12" Margin="16,24,16,0"
                        VerticalAlignment="Top"
                        IsVisible="{Binding IsLoading}">
                <TextBlock Text="{Binding ActivityText}" Classes="microLabel"
                           Foreground="{DynamicResource RdAccentBrush}" />
                <ProgressBar IsIndeterminate="True" Height="6" />
                <TextBlock Classes="muted"
                           Text="Reading the project's own files. Nothing is downloaded or run." />
            </StackPanel>

            <!-- ==================== Trouble ==================== -->
            <Border Grid.Row="1" Margin="16,20,16,0" VerticalAlignment="Top"
                    Background="{DynamicResource RdDangerSoftBrush}"
                    BorderBrush="{DynamicResource RdDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RdRadiusMedium}"
                    Padding="14"
                    IsVisible="{Binding HasError}">
                <StackPanel Spacing="8">
                    <TextBlock Text="THAT DID NOT WORK" Classes="microLabel"
                               Foreground="{DynamicResource RdDangerBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" Classes="body" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==================== The answers ==================== -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowBody}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="16,16,16,24">

                    <!-- 2. The picture, at a size where it can be read -->
                    <Border CornerRadius="{DynamicResource RdRadiusSmall}"
                            ClipToBounds="True"
                            BorderBrush="{DynamicResource RdBorderBrush}"
                            BorderThickness="1">
                        <Panel Height="180">
                            <Panel IsVisible="{Binding ShowHeroFallback}">
                                <Border Background="{Binding FallbackBrush}" />

                                <!-- RepoDeck's own artwork for this kind of project.
                                     Never a fabricated screenshot or logo. -->
                                <controls:KindArtwork Kind="{Binding FallbackKind}"
                                                      Initial="{Binding FallbackInitial}"
                                                      Accent="{DynamicResource RdOnAccentBrush}"
                                                      MarkScale="0.34"
                                                      Opacity="0.8" />

                                <Border Classes="chip"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="10">
                                    <TextBlock Text="{Binding FallbackCaption}" />
                                </Border>
                            </Panel>

                            <Image Source="{Binding Hero.Image}"
                                   IsVisible="{Binding ShowHero}"
                                   Stretch="UniformToFill"
                                   StretchDirection="Both" />
                        </Panel>
                    </Border>

                    <!--
                        The gallery. Selecting a thumbnail promotes it to the image above;
                        the tile already holds its bitmap, so nothing is fetched again. A
                        ListBox, so arrow keys move between pictures and focus is visible
                        without a pointer.
                    -->
                    <ListBox Classes="thumbs"
                             ItemsSource="{Binding Gallery}"
                             SelectedItem="{Binding Hero}"
                             SelectionMode="Single"
                             IsVisible="{Binding ShowScreenshotStrip}"
                             AutomationProperties.Name="Pictures from this project">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaTileViewModel">
                                <Border Width="74" Height="48"
                                        ClipToBounds="True"
                                        Background="{DynamicResource RdPanelInsetBrush}"
                                        CornerRadius="{DynamicResource RdRadiusSmall}"
                                        ToolTip.Tip="{Binding AccessibleName}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 3. One sentence saying what it is for -->
                    <TextBlock Text="{Binding WhatItIs}" Classes="body" TextWrapping="Wrap" />

                    <!-- 4, 5 and 6. Runs here, effort, cost - one line each -->
                    <Border Classes="inset">
                        <StackPanel Spacing="11">

                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Classes="led"
                                         Classes.ledOn="{Binding IsCompatible}"
                                         Classes.ledWarn="{Binding !CompatibilityIsKnown}"
                                         VerticalAlignment="Top" Margin="0,5,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="WORKS ON THIS PC" Classes="microLabel" />
                                    <TextBlock Text="{Binding CompatibilityText}" Classes="secondary"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Classes="led ledOff"
                                         VerticalAlignment="Top" Margin="0,5,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="SETUP" Classes="microLabel" />
                                    <TextBlock Text="{Binding SetupLabel}" Classes="body" />
                                    <TextBlock Text="{Binding SetupSummary}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Classes="led"
                                         Classes.ledOn="{Binding IsReadyToInstall}"
                                         Classes.ledBad="{Binding IsNotCompatible}"
                                         VerticalAlignment="Top" Margin="0,5,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="REPODECK CAN" Classes="microLabel" />
                                    <TextBlock Text="{Binding InstallabilityLabel}" Classes="body" />
                                    <TextBlock Text="{Binding InstallabilitySummary}" Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasDownloadSize}">
                                <Ellipse Grid.Column="0" Classes="led ledOff"
                                         VerticalAlignment="Top" Margin="0,5,10,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="DOWNLOAD SIZE" Classes="microLabel" />
                                    <TextBlock Text="{Binding DownloadSizeText}" Classes="body" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 7. The action -->
                    <StackPanel Spacing="8">
                        <Button Classes="primary" Content="INSTALL"
                                HorizontalAlignment="Stretch"
                                MinHeight="42"
                                IsVisible="{Binding ShowInstallAction}"
                                Command="{Binding InstallCommand}"
                                ToolTip.Tip="Opens the installation plan for you to confirm. Nothing is downloaded until you do." />

                        <Button Classes="primary" Content="RUN"
                                HorizontalAlignment="Stretch"
                                MinHeight="42"
                                IsVisible="{Binding ShowRunAction}"
                                Command="{Binding RunCommand}"
                                ToolTip.Tip="Start the copy RepoDeck installed" />

                        <Button Classes="secondary" Content="FULL DETAILS"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenDetailsCommand}" />
                    </StackPanel>

                    <!--
                        The reasoning. Everything that used to be strewn across the panel as
                        bullet lists - filenames, architectures, release contents, what the
                        analysis could not establish - grouped by the question it answers.
                        Nothing was removed to make room above.
                    -->
                    <Expander Header="WHY DOES REPODECK THINK THIS?"
                              IsExpanded="{Binding ReasoningExpanded}">
                        <StackPanel Spacing="14" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding Reasoning}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EvidenceGroup">
                                        <StackPanel Spacing="5" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Question}" Classes="microLabel" />
                                            <ItemsControl ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,3">
                                                            <TextBlock Grid.Column="0" Text="-" Classes="muted"
                                                                       VerticalAlignment="Top" Margin="0,0,7,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                                       Classes="muted" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SafetyDisclaimer}" Classes="muted"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource RdCautionBrush}" />
                        </StackPanel>
                    </Expander>

                    <!-- GitHub's own vocabulary lives here and nowhere else on this panel -->
                    <Expander Header="TECHNICAL DETAILS"
                              IsExpanded="{Binding TechnicalDetailsExpanded}">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding TechnicalDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TechnicalFact">
                                        <Grid ColumnDefinitions="120,*" Margin="0,0,0,6">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="muted" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                                                 FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="quiet" Content="SOURCE"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenOnGitHubCommand}"
                                    ToolTip.Tip="Open this project's source code on GitHub" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
