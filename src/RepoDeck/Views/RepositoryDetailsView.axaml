<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:models="using:RepoDeck.Models"
             xmlns:controls="using:RepoDeck.Controls"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="700"
             x:Class="RepoDeck.Views.RepositoryDetailsView"
             x:DataType="vm:RepositoryDetailsViewModel">

    <Panel>
        <ProgressBar IsIndeterminate="True" Height="3"
                     VerticalAlignment="Top"
                     IsVisible="{Binding IsLoading}" />

        <ScrollViewer>
            <StackPanel Margin="28,14,28,28" Spacing="16" MaxWidth="980" HorizontalAlignment="Left">

                <!--
                    Hero band. The strongest application-store moment RepoDeck has: a
                    picture, the name, what it is, whether it runs here, and the action -
                    all above the fold and none of it in GitHub's vocabulary.
                -->
                <Border Classes="panel" Padding="0" ClipToBounds="True">
                    <StackPanel Spacing="0">

                        <Panel Height="220" ClipToBounds="True">
                            <Panel IsVisible="{Binding ShowHeroFallback}">
                                <Border Background="{Binding FallbackBrush}" />
                                <Border Opacity="0.13">
                                    <Border.Background>
                                        <VisualBrush TileMode="Tile"
                                                     SourceRect="0,0,18,18"
                                                     DestinationRect="0,0,18,18">
                                            <VisualBrush.Visual>
                                                <Canvas Width="18" Height="18">
                                                    <Rectangle Width="18" Height="1" Fill="{DynamicResource RdGridLineBrush}" />
                                                    <Rectangle Width="1" Height="18" Fill="{DynamicResource RdGridLineBrush}" />
                                                </Canvas>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="{Binding FallbackInitial}"
                                           FontSize="86" FontWeight="Bold"
                                           Foreground="{DynamicResource RdOnAccentBrush}"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Panel>

                            <Image Source="{Binding Hero.Image}"
                                   IsVisible="{Binding !ShowHeroFallback}"
                                   Stretch="UniformToFill" />
                        </Panel>

                        <StackPanel Margin="20,18,20,18" Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding FriendlyTitle}" Classes="display" />
                                        <Border Classes="chip chipCaution" VerticalAlignment="Center"
                                                IsVisible="{Binding IsArchived}">
                                            <TextBlock Text="ABANDONED" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Owner}" Classes="muted" />
                                </StackPanel>

                                <Border Grid.Column="1" Classes="chip chipAccent"
                                        VerticalAlignment="Top"
                                        IsVisible="{Binding HasSetupAssessment}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="led ledOn" Width="6" Height="6" />
                                        <TextBlock Text="{Binding SetupLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding WhatItIs}" Classes="body"
                                       MaxLines="3" TextTrimming="CharacterEllipsis" />

                            <!-- Compatibility, stated as a sentence and marked with a light -->
                            <Border Classes="inset">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse Classes="led"
                                                 Classes.ledOn="{Binding WorksHereIsGood}"
                                                 Classes.ledWarn="{Binding !WorksHereIsGood}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WorksHereHeadline}" Classes="body"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ThisComputerText}" Classes="muted" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="secondary" Content="GITHUB"
                            Command="{Binding OpenOnGitHubCommand}" />
                    <Button Classes="secondary" Content="WEBSITE"
                            IsVisible="{Binding HasHomepage}"
                            Command="{Binding OpenHomepageCommand}" />
                    <Button Classes="secondary" Content="ALL VERSIONS"
                            Command="{Binding OpenReleasesCommand}" />
                </StackPanel>

                <!-- Error -->
                <Border Background="{DynamicResource RdDangerSoftBrush}"
                        BorderBrush="{DynamicResource RdDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RdRadiusMedium}" Padding="18"
                        IsVisible="{Binding HasError}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SOME INFORMATION COULD NOT BE LOADED" Classes="microLabel"
                                   Foreground="{DynamicResource RdDangerBrush}" />
                        <TextBlock Text="{Binding ErrorMessage}" Classes="body" />
                    </StackPanel>
                </Border>
                <!-- The four questions, answered before any GitHub terminology appears -->
                <Border Classes="panel">
                    <StackPanel Spacing="20">

                        <StackPanel Spacing="8">
                            <TextBlock Text="WHAT IS THIS?" Classes="sectionLabel" />
                            <TextBlock Text="{Binding WhatItIs}" Classes="body" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="WHAT CAN I DO WITH IT?" Classes="sectionLabel" />
                            <TextBlock Text="{Binding WhatYouCanDoWithIt}" Classes="body" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                            <!-- Will it work on this PC? -->
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="WILL IT WORK ON THIS PC?" Classes="sectionLabel" />
                                <TextBlock Text="{Binding WorksHereHeadline}" Classes="body"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WorksHereDetail}" Classes="secondary" />
                                <TextBlock Text="{Binding ThisComputerText}" Classes="muted" />
                            </StackPanel>

                            <!-- Can RepoDeck install it for me? -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="CAN REPODECK INSTALL IT FOR ME?" Classes="sectionLabel" />
                                <TextBlock Text="{Binding CanInstallHeadline}" Classes="body"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CanInstallDetail}" Classes="secondary" />
                            </StackPanel>
                        </Grid>

                        <!-- How much work is involved -->
                        <StackPanel Spacing="8" IsVisible="{Binding HasSetupAssessment}">
                            <TextBlock Text="HOW MUCH SETUP?" Classes="sectionLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="chip chipAccent" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SetupLabel}" />
                                </Border>
                                <TextBlock Text="{Binding SetupSummary}" Classes="body"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SetupReasons}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                            <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                                     Fill="{DynamicResource RdTextMutedBrush}" />
                                            <TextBlock Text="{Binding}" Classes="secondary" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- What it looks like -->
                <Border Classes="panel" IsVisible="{Binding ShowGallery}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="WHAT IT LOOKS LIKE" Classes="sectionLabel" />
                        <TextBlock Classes="muted"
                                   Text="Pictures from the project's own page. They may be out of date." />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Gallery}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MediaTileViewModel">
                                        <Border Width="320" Height="200" CornerRadius="10"
                                                ClipToBounds="True"
                                                Background="{DynamicResource RdSurfaceAltBrush}">
                                            <Image Source="{Binding Image}"
                                                   IsVisible="{Binding IsLoaded}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Analysis in progress -->
                <Border Classes="panel" IsVisible="{Binding AnalysisStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="REPODECK ANALYSIS" Classes="sectionLabel" />
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <TextBlock Text="{Binding AnalysisStatus}" Classes="secondary" />
                    </StackPanel>
                </Border>

                <!-- Technical detail: present, but one level in -->
                <Expander Header="Technical details" IsVisible="{Binding HasAnalysis}">
                    <StackPanel Spacing="18" Margin="0,10,0,0">

                        <!-- Incomplete analyses are never dressed up as confident ones -->
                        <Border Background="{DynamicResource RdCautionSoftBrush}"
                                CornerRadius="10" Padding="14"
                                IsVisible="{Binding AnalysisIsIncomplete}">
                            <TextBlock Text="{Binding AnalysisIncompleteReason}" Classes="body"
                                       Foreground="{DynamicResource RdCautionBrush}" />
                        </Border>

                        <!-- Project -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Project" Classes="h2" />
                            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Classes="muted" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ProjectTypeText}" Classes="secondary" />
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding ClassificationConfidenceText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Technology" Classes="muted" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TechnologyText}" Classes="secondary" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Platforms" Classes="muted" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlatformsText}" Classes="secondary" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Licence" Classes="muted" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseText}" Classes="secondary" />
                            </Grid>
                        </StackPanel>

                        <!-- Compatibility -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Compatibility" Classes="h2" />
                            <TextBlock Text="{Binding CompatibilityHeadline}" Classes="body"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding CompatibilityEvidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Evidence">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                                            <TextBlock Text="{Binding Marker}" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource RdTextMutedBrush}" />
                                            <TextBlock Text="{Binding Text}" Classes="secondary" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Recommended download -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Recommended download" Classes="h2" />

                            <StackPanel Spacing="8" IsVisible="{Binding HasRecommendation}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding RecommendedAssetName}" Classes="body"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecommendedAssetSize}" Classes="muted"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding PlanReleaseSummary}" Classes="muted" />
                                <TextBlock Text="Why this file?" Classes="muted" Margin="0,6,0,0" />
                                <ItemsControl ItemsSource="{Binding RecommendationReasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                                <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                                         Fill="{DynamicResource RdTextMutedBrush}" />
                                                <TextBlock Text="{Binding}" Classes="secondary" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding NoRecommendationReason}" Classes="body"
                                       IsVisible="{Binding !HasRecommendation}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Installation plan -->
                <Border Classes="panel" IsVisible="{Binding HasAnalysis}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="INSTALLATION PLAN" Classes="sectionLabel" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="chip chipAccent" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlanStrategyText}" />
                            </Border>
                            <TextBlock Text="{Binding PlanStepSummary}" Classes="secondary"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Reasons RepoDeck will not proceed -->
                        <Border Background="{DynamicResource RdCautionSoftBrush}"
                                CornerRadius="10" Padding="14"
                                IsVisible="{Binding PlanBlockers.Count}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="RepoDeck cannot install this" Classes="h2"
                                           Foreground="{DynamicResource RdCautionBrush}" />
                                <ItemsControl ItemsSource="{Binding PlanBlockers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Classes="secondary" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Warnings -->
                        <ItemsControl ItemsSource="{Binding PlanWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                                        <TextBlock Text="!" FontWeight="Bold" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource RdCautionBrush}" />
                                        <TextBlock Text="{Binding}" Classes="secondary" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Full preview of what would happen -->
                        <Expander Header="Installation preview" IsVisible="{Binding HasPlan}">
                            <StackPanel Spacing="12" Margin="0,10,0,0">
                                <TextBlock Classes="muted"
                                           Text="Nothing below has happened. This is what RepoDeck would do if installation were available." />

                                <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Would download" Classes="muted" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PlanDownloadSummary}"
                                               Classes="secondary" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="From" Classes="muted" />
                                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RepositoryUrl}"
                                                         Classes="secondary" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Would install into" Classes="muted" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlanDirectory}"
                                                         Classes="secondary" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Extraction needed" Classes="muted" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlanExtractionText}"
                                               Classes="secondary" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Administrator rights" Classes="muted" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PlanElevationText}"
                                               Classes="secondary" />
                                </Grid>

                                <StackPanel Spacing="6" IsVisible="{Binding ExecutableCandidates.Count}">
                                    <TextBlock Text="Would look for" Classes="muted" />
                                    <ItemsControl ItemsSource="{Binding ExecutableCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" Classes="secondary" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted"
                                               Text="These are expected names. RepoDeck has not downloaded anything, so it cannot yet confirm what the file contains." />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Install, confirm, progress, run -->
                        <StackPanel Spacing="12">

                            <!-- Nothing has happened yet -->
                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding ShowInstallButton}">
                                <Button Classes="primary" Content="Install"
                                        Command="{Binding BeginInstallCommand}" />
                                <TextBlock Classes="muted" VerticalAlignment="Center"
                                           Text="RepoDeck will show you the plan before it downloads anything." />
                            </StackPanel>

                            <!--
                                The confirmation step: the last moment before anything is
                                written, and the point where RepoDeck's whole argument
                                either holds or does not. A numbered list of what will
                                happen and an explicit list of what will not, both built
                                from the plan so they cannot drift from what it does.
                            -->
                            <Border Classes="panel"
                                    BorderBrush="{DynamicResource RdAccentBrush}"
                                    IsVisible="{Binding ShowConfirmation}">
                                <StackPanel Spacing="16" DataContext="{Binding Confirmation}"
                                            x:DataType="vm:InstallConfirmation">

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="READY TO INSTALL" Classes="microLabel"
                                                   Foreground="{DynamicResource RdAccentBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" Classes="display" />
                                            <TextBlock Text="{Binding VersionText}" Classes="h2"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource RdTextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- The facts, as headings rather than a sentence -->
                                    <WrapPanel ItemSpacing="40" LineSpacing="14">
                                        <StackPanel Spacing="2" IsVisible="{Binding HasDownloadSize}">
                                            <TextBlock Text="DOWNLOAD" Classes="microLabel" />
                                            <TextBlock Text="{Binding DownloadSizeText}" Classes="h2" />
                                            <TextBlock Text="{Binding AssetName}" Classes="muted" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="FROM" Classes="microLabel" />
                                            <TextBlock Text="{Binding SourceText}" Classes="h2" />
                                            <TextBlock Text="on GitHub" Classes="muted" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                                        <Border Grid.Column="0" Classes="inset">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="REPODECK WILL" Classes="microLabel"
                                                           Foreground="{DynamicResource RdAccentBrush}" />
                                                <ItemsControl ItemsSource="{Binding WillDo}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                                                                <Ellipse Grid.Column="0" Classes="led ledOn"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,5,9,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           Classes="secondary"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Classes="inset">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="REPODECK WILL NOT" Classes="microLabel"
                                                           Foreground="{DynamicResource RdCautionBrush}" />
                                                <ItemsControl ItemsSource="{Binding WillNotDo}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                                                                <TextBlock Grid.Column="0" Text="&#x2715;"
                                                                           Classes="muted"
                                                                           VerticalAlignment="Top"
                                                                           Margin="0,0,9,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           Classes="secondary"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="IT WILL GO HERE" Classes="microLabel" />
                                        <SelectableTextBlock Text="{Binding DestinationText}"
                                                             FontSize="12" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource RdTextSecondaryBrush}" />
                                    </StackPanel>

                                    <Border Background="{DynamicResource RdCautionSoftBrush}"
                                            BorderBrush="{DynamicResource RdCautionBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RdRadiusSmall}"
                                            Padding="12"
                                            IsVisible="{Binding HasWarnings}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="WORTH KNOWING" Classes="microLabel"
                                                       Foreground="{DynamicResource RdCautionBrush}" />
                                            <ItemsControl ItemsSource="{Binding Warnings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" Classes="secondary"
                                                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding ShowConfirmation}">
                                <Button Classes="secondary" Content="CANCEL" MinWidth="110"
                                        Command="{Binding CancelConfirmationCommand}" />
                                <Button Classes="primary" Content="INSTALL" MinWidth="130"
                                        MinHeight="40"
                                        Command="{Binding ConfirmInstallCommand}" />
                            </StackPanel>

                            <!--
                                Installing. Four named stages rather than one bar, because
                                "Installing..." tells nobody what is happening to their
                                computer, and the four stages are the whole argument for
                                trusting this, made visible while it happens.
                            -->
                            <Border Classes="inset" IsVisible="{Binding ShowProgress}">
                                <StackPanel Spacing="14" DataContext="{Binding Activity}"
                                            x:DataType="vm:InstallActivityViewModel">

                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InstallStageViewModel">
                                                <Grid ColumnDefinitions="Auto,104,*,Auto" Margin="0,0,0,9"
                                                      ToolTip.Tip="{Binding Description}">
                                                    <Ellipse Grid.Column="0" Classes="led"
                                                             Classes.ledOn="{Binding IsDone}"
                                                             Classes.ledWarn="{Binding IsActive}"
                                                             Classes.ledOff="{Binding IsWaiting}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,10,0" />

                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               Classes="microLabel"
                                                               VerticalAlignment="Center" />

                                                    <controls:SegmentedMeter Grid.Column="2" Height="12"
                                                                             SegmentCount="18"
                                                                             Value="{Binding Percent}"
                                                                             VerticalAlignment="Center"
                                                                             OnBrush="{DynamicResource RdAccentBrush}"
                                                                             OffBrush="{DynamicResource RdPanelInsetBrush}" />

                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}"
                                                               Classes="muted" Width="72"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding BytesText}" Classes="secondary"
                                               IsVisible="{Binding HasBytes}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="12"
                                        IsVisible="{Binding ShowProgress}">
                                <TextBlock Text="{Binding InstallProgressText}" Classes="secondary"
                                           VerticalAlignment="Center" />
                                <Button Classes="secondary" Content="CANCEL"
                                        Command="{Binding ConfirmInstallCancelCommand}" />
                            </StackPanel>

                            <!-- Installed -->
                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        IsVisible="{Binding ShowRunButton}">
                                <Button Classes="primary" Command="{Binding RunCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="&#x25B6;" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RunButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding InstalledVersionText}" Classes="muted"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10"
                                        IsVisible="{Binding ShowOpenFolder}">
                                <Button Classes="secondary" Content="Open folder"
                                        Command="{Binding OpenInstallFolderCommand}" />
                                <Button Classes="secondary" Content="Uninstall"
                                        IsVisible="{Binding ShowUninstallButton}"
                                        Command="{Binding BeginUninstallCommand}" />
                            </StackPanel>

                            <!-- Removing an application is never one click -->
                            <Border Background="{DynamicResource RdDangerSoftBrush}"
                                    CornerRadius="10" Padding="14"
                                    IsVisible="{Binding IsConfirmingUninstall}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="body"
                                               Text="Remove this and everything RepoDeck installed for it?" />
                                    <TextBlock Classes="muted"
                                               Text="Only RepoDeck's own folder for this application is deleted." />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="primary" Content="Remove it"
                                                Command="{Binding UninstallCommand}" />
                                        <Button Classes="secondary" Content="Keep it"
                                                Command="{Binding CancelUninstallCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding InstallMessage}" Classes="secondary"
                                       IsVisible="{Binding HasInstallMessage}" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- Things worth knowing -->
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="THINGS WORTH KNOWING" Classes="sectionLabel" />
                        <TextBlock Classes="muted"
                                   Text="These are facts from GitHub, not a safety verdict. RepoDeck does not judge whether software is trustworthy." />

                        <ItemsControl ItemsSource="{Binding Signals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RepositorySignal">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                                        <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                Margin="0,2,12,2"
                                                Background="{DynamicResource RdTextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="secondary" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Every file published with this version -->
                <Expander Header="All downloads in this version" IsVisible="{Binding HasReleasesToShow}">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <TextBlock Classes="muted"
                                   Text="Listed exactly as GitHub reports them. RepoDeck does not yet work out which file suits your computer." />

                        <ItemsControl ItemsSource="{Binding Releases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReleaseSummary">
                                    <Border Background="{DynamicResource RdSurfaceAltBrush}"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Classes="h2" />
                                                    <TextBlock Text="{Binding PublishedText}" Classes="muted" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                    <Border Classes="chip">
                                                        <TextBlock Text="{Binding Kind}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AssetSummary}" Classes="muted"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Assets}"
                                                          IsVisible="{Binding HasAssets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReleaseAssetSummary">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       Classes="muted" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                                       Classes="muted" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Technical detail, kept separate from the plain-English part -->
                <Expander Header="GitHub information">
                    <StackPanel Spacing="14" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stars" Classes="muted" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StarsText}" Classes="secondary" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Forks" Classes="muted" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ForksText}" Classes="secondary" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Open issues" Classes="muted" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IssuesText}" Classes="secondary" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Written in" Classes="muted" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LanguageText}" Classes="secondary" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Licence" Classes="muted" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LicenseText}" Classes="secondary" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Created" Classes="muted" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CreatedText}" Classes="secondary" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Last updated" Classes="muted" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UpdatedText}" Classes="secondary" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Main branch" Classes="muted" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DefaultBranchText}" Classes="secondary" />
                        </Grid>

                        <StackPanel Spacing="8" IsVisible="{Binding HasLanguages}">
                            <TextBlock Text="Languages" Classes="muted" />
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageShare">
                                        <Grid ColumnDefinitions="140,Auto,*" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="secondary" />
                                            <Border Grid.Column="1" Height="8" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Width="{Binding BarWidth}"
                                                    Background="{DynamicResource RdAccentBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}"
                                                       Classes="muted" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding HasTopics}">
                            <TextBlock Text="Topics" Classes="muted" />
                            <ItemsControl ItemsSource="{Binding Topics}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="chip">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Page on GitHub" Classes="muted" />
                            <SelectableTextBlock Text="{Binding RepositoryUrl}" Classes="secondary" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- README -->
                <Expander Header="Read me">
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ReadmeNotice}" Classes="muted" />
                        <ItemsControl ItemsSource="{Binding ReadmeBlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ReadmeBlock">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" Classes="h2" Margin="0,14,0,4"
                                                   IsVisible="{Binding IsHeading}" />
                                        <TextBlock Text="{Binding Text}" Classes="body" Margin="0,0,0,8"
                                                   IsVisible="{Binding IsParagraph}" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,4"
                                                    IsVisible="{Binding IsListItem}">
                                            <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                                                     Fill="{DynamicResource RdTextMutedBrush}" />
                                            <TextBlock Text="{Binding Text}" Classes="secondary" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource RdSurfaceAltBrush}"
                                                CornerRadius="8" Padding="12" Margin="0,4,0,10"
                                                IsVisible="{Binding IsCode}">
                                            <SelectableTextBlock Text="{Binding Text}"
                                                                 FontFamily="Consolas,Menlo,monospace"
                                                                 FontSize="12"
                                                                 TextWrapping="NoWrap" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource RdBorderBrush}"
                                                BorderThickness="3,0,0,0" Padding="12,2,0,2" Margin="0,4,0,8"
                                                IsVisible="{Binding IsQuote}">
                                            <TextBlock Text="{Binding Text}" Classes="secondary" FontStyle="Italic" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
