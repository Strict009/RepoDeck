<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RepoDeck.Views.InstalledView"
             x:DataType="vm:InstalledViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28,22,28,0">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Installed" Classes="display" />
            <TextBlock Classes="secondary"
                       Text="Applications RepoDeck installed into its own folder and can run." />
            <TextBlock Text="{Binding Message}" Classes="muted"
                       IsVisible="{Binding HasMessage}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12" MaxWidth="560" HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ShowEmptyState}">
            <TextBlock Text="Nothing installed yet" Classes="h1" />
            <TextBlock Classes="body" Foreground="{DynamicResource RdTextSecondaryBrush}"
                       Text="Find something on the Discover page. RepoDeck shows you exactly what it will download and where it will put it before anything happens." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowList}">
            <ItemsControl ItemsSource="{Binding Applications}" Margin="0,0,14,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstalledAppViewModel">
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel Spacing="0">

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Name}" Classes="h1" />
                                            <Border Classes="chip" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionText}" />
                                            </Border>
                                            <Border Classes="chip chipCaution" VerticalAlignment="Center"
                                                    IsVisible="{Binding NeedsAttention}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Owner}" Classes="muted" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Classes="primary"
                                            VerticalAlignment="Top"
                                            IsEnabled="{Binding CanRun}"
                                            Command="{Binding RunCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#x25B6;" VerticalAlignment="Center" />
                                            <TextBlock Text="Run" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <WrapPanel ItemSpacing="18" LineSpacing="6" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding InstalledText}" Classes="muted" />
                                    <TextBlock Text="{Binding PlatformText}" Classes="muted"
                                               IsVisible="{Binding HasPlatformText}" />
                                    <TextBlock Text="{Binding SizeText}" Classes="muted" />
                                    <TextBlock Text="{Binding LastRunText}" Classes="muted" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Classes="muted" />
                                </WrapPanel>

                                <!-- Several files looked like the program: the user decides -->
                                <Border Background="{DynamicResource RdCautionSoftBrush}"
                                        CornerRadius="10" Padding="14" Margin="0,14,0,0"
                                        IsVisible="{Binding NeedsExecutableChoice}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding AmbiguityMessage}" Classes="body"
                                                   Foreground="{DynamicResource RdCautionBrush}" />
                                        <TextBlock Classes="muted"
                                                   Text="RepoDeck will not guess. Choose the one to run; the others are kept." />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ComboBox MinWidth="320"
                                                      ItemsSource="{Binding ExecutableCandidates}"
                                                      SelectedItem="{Binding SelectedCandidate}" />
                                            <Button Classes="primary" Content="Use this one"
                                                    Command="{Binding ChooseExecutableCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                                    <Button Classes="secondary" Content="Open folder"
                                            Command="{Binding OpenFolderCommand}" />
                                    <Button Classes="secondary" Content="GitHub"
                                            Command="{Binding ViewRepositoryCommand}" />
                                    <Button Classes="secondary" Content="Uninstall"
                                            IsVisible="{Binding ShowUninstallButton}"
                                            Command="{Binding BeginUninstallCommand}" />
                                </StackPanel>

                                <!-- Removing an application is never one click -->
                                <Border Background="{DynamicResource RdDangerSoftBrush}"
                                        CornerRadius="10" Padding="14" Margin="0,12,0,0"
                                        IsVisible="{Binding IsConfirmingUninstall}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="body"
                                                   Text="Remove this application and everything RepoDeck installed for it?" />
                                        <TextBlock Classes="muted"
                                                   Text="Only RepoDeck's own folder for this application is deleted. Nothing else on your computer is touched." />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Classes="primary" Content="Remove it"
                                                    Command="{Binding ConfirmUninstallCommand}" />
                                            <Button Classes="secondary" Content="Keep it"
                                                    Command="{Binding CancelUninstallCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
