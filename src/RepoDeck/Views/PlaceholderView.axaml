<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="RepoDeck.Views.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">

    <Border Padding="28">
        <Border Classes="panel"
                MaxWidth="620"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding Title}" Classes="h1" />
                <TextBlock Text="{Binding Description}" Classes="body"
                           Foreground="{DynamicResource RdTextSecondaryBrush}" />
                <Border Classes="chip chipAccent" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Milestone}" />
                </Border>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
