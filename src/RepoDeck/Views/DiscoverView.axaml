<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             xmlns:infra="using:RepoDeck.Infrastructure"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
             x:Class="RepoDeck.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="CardResultTemplate" x:DataType="vm:RepositoryCardViewModel">
            <ContentControl Content="{Binding}" />
        </DataTemplate>

        <DataTemplate x:Key="CompactResultTemplate" x:DataType="vm:RepositoryCardViewModel">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,8">
                <Border Grid.Row="0" Grid.Column="0" Width="40" Height="40"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource RdRadiusSmall}"
                        Margin="0,0,12,0">
                    <Panel ToolTip.Tip="{Binding KindExplanation}">
                        <Border Background="{Binding FallbackBrush}"
                                IsVisible="{Binding ShowFallback}" />
                        <controls:KindArtwork Kind="{Binding Kind}"
                                              Initial="{Binding FallbackInitial}"
                                              Accent="{DynamicResource RdOnAccentBrush}"
                                              MarkScale="0.62"
                                              Opacity="0.85"
                                              IsVisible="{Binding ShowFallback}" />
                        <Image Source="{Binding Image}"
                               IsVisible="{Binding ShowImage}"
                               Stretch="UniformToFill" />
                    </Panel>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FriendlyName}" Classes="cardTitle" />
                    <TextBlock Text="{Binding Purpose}" Classes="muted"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>

                <!-- One pill, always with words in it. Unknown is the commonest answer by
                     far, and it reads neutral: RepoDeck not having looked yet is not a
                     warning about the software. -->
                <Border Grid.Row="0" Grid.Column="2" Margin="14,0"
                        Classes="statusPill"
                        Classes.positive="{Binding IsReadyToInstall}"
                        Classes.caution="{Binding IsDeveloperFocused}"
                        Classes.danger="{Binding IsNotCompatible}"
                        Classes.neutral="{Binding !IsInstallabilityKnown}"
                        ToolTip.Tip="{Binding InstallabilityExplanation}">
                    <TextBlock Text="{Binding InstallabilityLabel}" />
                </Border>

                <Button Grid.Row="0" Grid.Column="3" Classes="quiet" Content="WHY?"
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        Command="{Binding ToggleWhyCommand}" />

                <Button Grid.Row="0" Grid.Column="4" Classes="primary"
                        Content="{Binding PrimaryActionLabel}"
                        VerticalAlignment="Center"
                        Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding PrimaryActionTooltip}" />

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                        Classes="inset" Margin="52,8,0,0" Padding="10"
                        IsVisible="{Binding IsWhyExpanded}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding WhyHeading}" Classes="microLabel" />
                        <ItemsControl ItemsSource="{Binding WhyReasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="muted"
                                               TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Name="DiscoverRoot" ColumnDefinitions="*,Auto">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="28,22,28,0">

        <!-- ==================== Search ==================== -->
        <StackPanel Grid.Row="0" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Discover" Classes="display" />
                    <TextBlock Text="What do you want your PC to do?" Classes="secondary"
                               IsVisible="{Binding ShowHome}" />
                    <TextBlock Text="Find something useful" Classes="secondary"
                               IsVisible="{Binding !ShowHome}" />
                </StackPanel>

                <!--
                    Apps or Everything. A mode rather than a checkbox: "Programs only"
                    sounded like a filter that throws things away, and this is a choice
                    about what kind of browsing is happening.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                            VerticalAlignment="Bottom"
                            ToolTip.Tip="{Binding BrowseModeExplanation}">
                    <TextBlock Text="SHOW" Classes="microLabel" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Classes="segment"
                            Classes.segmentActive="{Binding IsAppsMode}"
                            MinWidth="96"
                            Content="APPS"
                            ToolTip.Tip="Focus on programs you can actually use."
                            AutomationProperties.Name="Apps: focus on programs you can actually use"
                            Command="{Binding UseAppsModeCommand}" />
                    <Button Classes="segment"
                            Classes.segmentActive="{Binding IsAllProjectsMode}"
                            MinWidth="132"
                            Content="ALL PROJECTS"
                            ToolTip.Tip="Include libraries, source projects, websites and developer tools."
                            AutomationProperties.Name="All Projects: include libraries, source projects, websites and developer tools"
                            Command="{Binding UseAllProjectsModeCommand}" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Classes="search"
                         Name="SearchBox"
                         PlaceholderText="Search for apps, tools, games, or describe what you need..."
                         Text="{Binding SearchText}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="primary"
                        Margin="10,0,0,0"
                        MinHeight="44" MinWidth="110"
                        Content="SEARCH"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="2"
                        Classes="secondary"
                        Margin="8,0,0,0"
                        MinHeight="44"
                        Content="STOP"
                        IsVisible="{Binding IsBusy}"
                        Command="{Binding SearchCancelCommand}" />
            </Grid>

            <TextBlock Classes="muted"
                       Text="{Binding BrowseModeExplanation}" TextWrapping="Wrap" MaxWidth="820"
                       HorizontalAlignment="Left"
                       IsVisible="{Binding ShowResultControls}" />
        </StackPanel>

        <!-- ==================== Filters ==================== -->
        <Border Grid.Row="1" Margin="0,16,0,14" Padding="0"
                IsVisible="{Binding ShowResultControls}">
            <StackPanel Spacing="10">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              MinWidth="140"
                              ToolTip.Tip="How results are ordered" />

                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              MinWidth="140"
                              ToolTip.Tip="Restrict results to one programming language" />

                    <ComboBox ItemsSource="{Binding StarsOptions}"
                              SelectedItem="{Binding SelectedStars}"
                              MinWidth="140"
                              ToolTip.Tip="Filter by how many people have starred the project" />

                    <ComboBox ItemsSource="{Binding UpdatedOptions}"
                              SelectedItem="{Binding SelectedUpdated}"
                              MinWidth="140"
                              ToolTip.Tip="Filter by when the project was last worked on" />

                    <CheckBox Content="Hide abandoned"
                              IsChecked="{Binding ExcludeArchived}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Hide projects the authors have stopped maintaining" />

                    <Button Classes="link" Content="RESET"
                            VerticalAlignment="Center"
                            Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowResults}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding ResultSummary}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Card or Compact. The choice is remembered between runs. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="VIEW" Classes="microLabel" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Classes="segment"
                                Classes.segmentActive="{Binding IsCardView}"
                                Content="CARD"
                                Command="{Binding UseCardViewCommand}"
                                ToolTip.Tip="Picture-led cards" />
                        <Button Classes="segment"
                                Classes.segmentActive="{Binding IsCompactView}"
                                Content="COMPACT"
                                Command="{Binding UseCompactViewCommand}"
                                ToolTip.Tip="One dense row per project" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== States ==================== -->
        <Panel Grid.Row="2">

            <!-- Working -->
            <Border IsVisible="{Binding IsBusy}" VerticalAlignment="Top" Margin="0,40,0,0">
                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="360">
                    <TextBlock Text="SEARCHING" Classes="microLabel" HorizontalAlignment="Center"
                               Foreground="{DynamicResource RdAccentBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="6" />
                    <TextBlock Text="Asking GitHub..." Classes="secondary" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Trouble -->
            <Border IsVisible="{Binding HasError}" VerticalAlignment="Top" Margin="0,24,0,0">
                <Border Background="{DynamicResource RdDangerSoftBrush}"
                        BorderBrush="{DynamicResource RdDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RdRadiusMedium}"
                        Padding="20"
                        MaxWidth="640"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <TextBlock Text="THAT DID NOT WORK" Classes="microLabel"
                                   Foreground="{DynamicResource RdDangerBrush}" />
                        <TextBlock Text="{Binding ErrorMessage}" Classes="body" />
                        <Button Classes="secondary" Content="TRY AGAIN"
                                HorizontalAlignment="Left"
                                Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Landing -->
            <ScrollViewer IsVisible="{Binding ShowHome}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="34" Margin="0,10,14,36" MaxWidth="1180" HorizontalAlignment="Left">

                    <!--
                        ==================== Categories ====================
                        Subjects, drawn with the same kind marks the cards use, so the
                        visual language is one language rather than two.
                    -->
                    <StackPanel Spacing="14">
                        <TextBlock Text="BROWSE BY CATEGORY" Classes="sectionLabel" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="12" LineSpacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoverCategory">
                                    <Button Classes="tile" Width="240" Height="112" Padding="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SearchCategoryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Description}">
                                        <Grid ColumnDefinitions="Auto,*" Margin="14,12">
                                            <Border Grid.Column="0" Width="46" Height="46"
                                                    VerticalAlignment="Top"
                                                    ClipToBounds="True" Margin="0,0,13,0"
                                                    CornerRadius="{DynamicResource RdRadiusSmall}">
                                                <Panel>
                                                    <Border Background="{DynamicResource RdPanelInsetBrush}" />
                                                    <controls:KindArtwork Kind="{Binding Kind}"
                                                                          Initial=""
                                                                          Accent="{DynamicResource RdAccentBrush}"
                                                                          MarkScale="0.56"
                                                                          Opacity="0.9" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="15"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Classes="muted"
                                                           TextWrapping="Wrap" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--
                        ==================== Featured collections ====================
                        Ways of slicing the search rather than subjects. Three of the four
                        are about how a program is delivered, which is the thing a beginner
                        cannot judge and the thing that decides whether RepoDeck can help.

                        Each description says what it actually asks GitHub for. "Popular on
                        GitHub" is deliberately not promoted here: giving it a large card
                        would turn a star count owned by GitHub into a recommendation owned
                        by RepoDeck, which is the one line this project does not cross.
                    -->
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="COLLECTIONS" Classes="sectionLabel" />
                            <TextBlock Classes="muted"
                                       Text="Each of these is a search. Nothing here is hand-picked, and nothing is a recommendation." />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FeaturedCollections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="12" LineSpacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoverCollection">
                                    <Button Classes="tile" Width="278" Height="158" Padding="0"
                                            Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SearchCollectionCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Description}">
                                        <StackPanel Margin="16,14" Spacing="11">
                                            <Border Width="52" Height="52"
                                                    ClipToBounds="True" HorizontalAlignment="Left"
                                                    CornerRadius="{DynamicResource RdRadiusSmall}">
                                                <Panel>
                                                    <Border Background="{DynamicResource RdPanelInsetBrush}" />
                                                    <controls:KindArtwork Kind="{Binding Kind}"
                                                                          Initial=""
                                                                          Accent="{DynamicResource RdAccentBrush}"
                                                                          MarkScale="0.58" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Label}" FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource RdAccentBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" Classes="muted"
                                                           TextWrapping="Wrap" MaxLines="3"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <ItemsControl ItemsSource="{Binding OtherCollections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoverCollection">
                                        <Button Classes="secondary"
                                                Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SearchCollectionCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Description}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </StackPanel>

                    <!--
                        ==================== Recently viewed ====================
                        Only when there is something to show. An empty "Recently viewed"
                        heading on a first run is a promise of content that is not there.
                    -->
                    <StackPanel Spacing="14" IsVisible="{Binding HasRecentlyViewed}">
                        <TextBlock Text="RECENTLY VIEWED" Classes="sectionLabel" />
                        <ItemsControl ItemsSource="{Binding RecentlyViewed}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentProjectViewModel">
                                    <Button Classes="tile" Width="228" Height="88" Padding="0"
                                            Command="{Binding OpenCommand}"
                                            ToolTip.Tip="{Binding FullName}">
                                        <Grid ColumnDefinitions="Auto,*" Margin="12,10">
                                            <Border Grid.Column="0" Width="38" Height="38"
                                                    VerticalAlignment="Top" Margin="0,0,11,0"
                                                    ClipToBounds="True"
                                                    CornerRadius="{DynamicResource RdRadiusSmall}">
                                                <Panel>
                                                    <Border Background="{Binding FallbackBrush}" />
                                                    <controls:KindArtwork Kind="{Binding Kind}"
                                                                          Initial="{Binding FallbackInitial}"
                                                                          Accent="{DynamicResource RdOnAccentBrush}"
                                                                          MarkScale="0.56"
                                                                          Opacity="0.88" />
                                                </Panel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Owner}" Classes="muted"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WhenText}" Classes="muted" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== Suggestions ==================== -->
                    <StackPanel Spacing="14">
                        <TextBlock Text="NOT SURE WHAT TO SEARCH FOR?" Classes="sectionLabel" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="secondary" Content="Edit videos"
                                    Command="{Binding SearchForCommand}" CommandParameter="video editor" />
                            <Button Classes="secondary" Content="Send files"
                                    Command="{Binding SearchForCommand}" CommandParameter="send files between devices" />
                            <Button Classes="secondary" Content="Music player"
                                    Command="{Binding SearchForCommand}" CommandParameter="music player" />
                            <Button Classes="secondary" Content="Record my screen"
                                    Command="{Binding SearchForCommand}" CommandParameter="screen recorder" />
                            <Button Classes="secondary" Content="Retro games"
                                    Command="{Binding SearchForCommand}" CommandParameter="retro game emulator" />
                            <Button Classes="secondary" Content="Find duplicate files"
                                    Command="{Binding SearchForCommand}" CommandParameter="find duplicate files" />
                            <Button Classes="secondary" Content="Password manager"
                                    Command="{Binding SearchForCommand}" CommandParameter="password manager" />
                            <Button Classes="secondary" Content="Take notes"
                                    Command="{Binding SearchForCommand}" CommandParameter="note taking app" />
                        </WrapPanel>
                    </StackPanel>

                    <!--
                        ==================== How RepoDeck works ====================
                        Three steps rather than a paragraph. The third is worded carefully:
                        RepoDeck installs what it has a plan for and hands over what it
                        does not, and the safety line below it has to stay true of the
                        installer as it actually behaves, not as a slogan.
                    -->
                    <StackPanel Spacing="14">
                        <TextBlock Text="HOW REPODECK WORKS" Classes="sectionLabel" />

                        <WrapPanel ItemSpacing="12" LineSpacing="12">
                            <Border Classes="inset" Width="292" Padding="17,15">
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="1" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource RdAccentBrush}" />
                                        <TextBlock Text="SEARCH" Classes="microLabel"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="Tell RepoDeck what you want your PC to do." />
                                </StackPanel>
                            </Border>

                            <Border Classes="inset" Width="292" Padding="17,15">
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="2" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource RdAccentBrush}" />
                                        <TextBlock Text="UNDERSTAND" Classes="microLabel"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="RepoDeck explains what it found and whether it works on this computer." />
                                </StackPanel>
                            </Border>

                            <Border Classes="inset" Width="292" Padding="17,15">
                                <StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="3" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource RdAccentBrush}" />
                                        <TextBlock Text="INSTALL" Classes="microLabel"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="When RepoDeck understands how to install it, it can handle the supported installation for you." />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="900"
                                   Text="You're always in control. RepoDeck doesn't silently run scripts or installers." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Nothing found -->
            <Border IsVisible="{Binding ShowEmptyState}" VerticalAlignment="Top" Margin="0,40,0,0">
                <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="NOTHING MATCHED" Classes="microLabel"
                               Foreground="{DynamicResource RdCautionBrush}" />
                    <TextBlock Text="Nothing matched that search" Classes="h1" />
                    <TextBlock Classes="body" Foreground="{DynamicResource RdTextSecondaryBrush}"
                               Text="Try fewer words, or loosen the filters. The stars, language and date filters can rule out a lot at once." />
                    <Button Classes="secondary" Content="RESET FILTERS" HorizontalAlignment="Left"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <ScrollViewer Name="ResultsScroller" IsVisible="{Binding ShowResults}">
                <StackPanel Spacing="0" Margin="0,0,14,24">

                    <!-- Apps mode keeps every result, but separates strong application
                         evidence from repositories that still need inspection. -->
                    <StackPanel IsVisible="{Binding ShowGroupedResults}" Spacing="24">
                        <StackPanel IsVisible="{Binding HasBestMatches}" Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="BEST SEARCH MATCHES" Classes="sectionLabel" />
                                <TextBlock Text="Projects with evidence that they are end-user applications relevant to this search."
                                           Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>

                            <ListBox Classes="cards" IsVisible="{Binding IsCardView}"
                                     ItemsSource="{Binding BestMatches}"
                                     ItemTemplate="{StaticResource CardResultTemplate}"
                                     SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                     SelectionChanged="OnResultSelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveCardsPanel
                                            MinItemWidth="{DynamicResource RdCardMinWidth}"
                                            MaxColumns="3" Spacing="{DynamicResource RdCardSpacing}" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <ListBox Classes="rows" IsVisible="{Binding IsCompactView}"
                                     ItemsSource="{Binding BestMatches}"
                                     ItemTemplate="{StaticResource CompactResultTemplate}"
                                     SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                     SelectionChanged="OnResultSelectionChanged" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasOtherResults}" Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="OTHER RESULTS" Classes="sectionLabel" />
                                <TextBlock Text="Relevant repositories without enough evidence to call them strong software matches."
                                           Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>

                            <ListBox Classes="cards" IsVisible="{Binding IsCardView}"
                                     ItemsSource="{Binding OtherResults}"
                                     ItemTemplate="{StaticResource CardResultTemplate}"
                                     SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                     SelectionChanged="OnResultSelectionChanged">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveCardsPanel
                                            MinItemWidth="{DynamicResource RdCardMinWidth}"
                                            MaxColumns="3" Spacing="{DynamicResource RdCardSpacing}" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <ListBox Classes="rows" IsVisible="{Binding IsCompactView}"
                                     ItemsSource="{Binding OtherResults}"
                                     ItemTemplate="{StaticResource CompactResultTemplate}"
                                     SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                     SelectionChanged="OnResultSelectionChanged" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Everything mode preserves GitHub's ordering and does not group. -->
                    <Panel IsVisible="{Binding ShowUngroupedResults}">
                        <ListBox Classes="cards" IsVisible="{Binding IsCardView}"
                                 ItemsSource="{Binding Results}"
                                 ItemTemplate="{StaticResource CardResultTemplate}"
                                 SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                 SelectionChanged="OnResultSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveCardsPanel
                                        MinItemWidth="{DynamicResource RdCardMinWidth}"
                                        MaxColumns="3" Spacing="{DynamicResource RdCardSpacing}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <ListBox Classes="rows" IsVisible="{Binding IsCompactView}"
                                 ItemsSource="{Binding Results}"
                                 ItemTemplate="{StaticResource CompactResultTemplate}"
                                 SelectedItem="{Binding SelectedResult, Mode=OneWay}" SelectionMode="Single"
                                 SelectionChanged="OnResultSelectionChanged" />
                    </Panel>

                    <Button Classes="secondary"
                            Content="SHOW MORE RESULTS"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            IsVisible="{Binding CanLoadMore}"
                            IsEnabled="{Binding !IsLoadingMore}"
                            Command="{Binding LoadMoreCommand}" />

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                 IsVisible="{Binding IsLoadingMore}" />
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>

    <!--
        Quick Look. Beside the results where there is room for both, and over them where
        there is not - it is the last child, so it draws on top. It never navigates away
        from the search, so comparing candidates does not mean losing your place.
    -->
    <ContentControl Width="380"
                    HorizontalAlignment="Right"
                    Content="{Binding QuickLook}"
                    IsVisible="{Binding QuickLook.ShowPanel, FallbackValue=False}"
                    Grid.Column="{Binding #DiscoverRoot.Bounds.Width,
                                          Converter={x:Static infra:PanelDisplayConverter.Instance}}"
                    Grid.ColumnSpan="{Binding #DiscoverRoot.Bounds.Width,
                                              Converter={x:Static infra:PanelDisplayConverter.Instance},
                                              ConverterParameter=span}" />
    </Grid>
</UserControl>
