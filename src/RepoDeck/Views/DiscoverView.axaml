<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RepoDeck.ViewModels"
             xmlns:controls="using:RepoDeck.Controls"
             xmlns:infra="using:RepoDeck.Infrastructure"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
             x:Class="RepoDeck.Views.DiscoverView"
             x:DataType="vm:DiscoverViewModel">

    <Grid Name="DiscoverRoot" ColumnDefinitions="*,Auto">

    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="28,22,28,0">

        <!-- ==================== Search ==================== -->
        <StackPanel Grid.Row="0" Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Discover" Classes="display" />
                    <TextBlock Text="Find something useful" Classes="secondary" />
                </StackPanel>

                <!--
                    Apps or Everything. A mode rather than a checkbox: "Programs only"
                    sounded like a filter that throws things away, and this is a choice
                    about what kind of browsing is happening.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                            VerticalAlignment="Bottom"
                            ToolTip.Tip="{Binding BrowseModeExplanation}">
                    <TextBlock Text="SHOW" Classes="microLabel" VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button Classes="segment"
                            Classes.segmentActive="{Binding IsAppsMode}"
                            MinWidth="96"
                            Content="APPS"
                            Command="{Binding UseAppsModeCommand}" />
                    <Button Classes="segment"
                            Classes.segmentActive="{Binding IsEverythingMode}"
                            MinWidth="118"
                            Content="EVERYTHING"
                            Command="{Binding UseEverythingModeCommand}" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Classes="search"
                         Name="SearchBox"
                         PlaceholderText="What do you want your PC to do?"
                         Text="{Binding SearchText}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Classes="primary"
                        Margin="10,0,0,0"
                        MinHeight="44" MinWidth="110"
                        Content="SEARCH"
                        IsEnabled="{Binding !IsBusy}"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="2"
                        Classes="secondary"
                        Margin="8,0,0,0"
                        MinHeight="44"
                        Content="STOP"
                        IsVisible="{Binding IsBusy}"
                        Command="{Binding SearchCancelCommand}" />
            </Grid>

            <TextBlock Classes="muted"
                       Text="{Binding BrowseModeExplanation}" TextWrapping="Wrap" MaxWidth="820"
                       HorizontalAlignment="Left" />
        </StackPanel>

        <!-- ==================== Filters ==================== -->
        <Border Grid.Row="1" Margin="0,16,0,14" Padding="0">
            <StackPanel Spacing="10">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              MinWidth="140"
                              ToolTip.Tip="How results are ordered" />

                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage}"
                              MinWidth="140"
                              ToolTip.Tip="Restrict results to one programming language" />

                    <ComboBox ItemsSource="{Binding StarsOptions}"
                              SelectedItem="{Binding SelectedStars}"
                              MinWidth="140"
                              ToolTip.Tip="Filter by how many people have starred the project" />

                    <ComboBox ItemsSource="{Binding UpdatedOptions}"
                              SelectedItem="{Binding SelectedUpdated}"
                              MinWidth="140"
                              ToolTip.Tip="Filter by when the project was last worked on" />

                    <CheckBox Content="Hide abandoned"
                              IsChecked="{Binding ExcludeArchived}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Hide projects the authors have stopped maintaining" />

                    <Button Classes="link" Content="RESET"
                            VerticalAlignment="Center"
                            Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowResults}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding ResultSummary}" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HiddenByFilterNotice}" Classes="muted" VerticalAlignment="Center"
                                   IsVisible="{Binding HiddenByFilterNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- Card or Compact. The choice is remembered between runs. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="VIEW" Classes="microLabel" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Classes="segment"
                                Classes.segmentActive="{Binding IsCardView}"
                                Content="CARD"
                                Command="{Binding UseCardViewCommand}"
                                ToolTip.Tip="Picture-led cards" />
                        <Button Classes="segment"
                                Classes.segmentActive="{Binding IsCompactView}"
                                Content="COMPACT"
                                Command="{Binding UseCompactViewCommand}"
                                ToolTip.Tip="One dense row per project" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== States ==================== -->
        <Panel Grid.Row="2">

            <!-- Working -->
            <Border IsVisible="{Binding IsBusy}" VerticalAlignment="Top" Margin="0,40,0,0">
                <StackPanel Spacing="14" HorizontalAlignment="Center" MaxWidth="360">
                    <TextBlock Text="SEARCHING" Classes="microLabel" HorizontalAlignment="Center"
                               Foreground="{DynamicResource RdAccentBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="6" />
                    <TextBlock Text="Asking GitHub..." Classes="secondary" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Trouble -->
            <Border IsVisible="{Binding HasError}" VerticalAlignment="Top" Margin="0,24,0,0">
                <Border Background="{DynamicResource RdDangerSoftBrush}"
                        BorderBrush="{DynamicResource RdDangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RdRadiusMedium}"
                        Padding="20"
                        MaxWidth="640"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <TextBlock Text="THAT DID NOT WORK" Classes="microLabel"
                                   Foreground="{DynamicResource RdDangerBrush}" />
                        <TextBlock Text="{Binding ErrorMessage}" Classes="body" />
                        <Button Classes="secondary" Content="TRY AGAIN"
                                HorizontalAlignment="Left"
                                Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Landing -->
            <ScrollViewer IsVisible="{Binding ShowWelcome}">
                <StackPanel Spacing="22" Margin="0,8,14,28">

                    <StackPanel Spacing="12">
                        <TextBlock Text="BROWSE BY CATEGORY" Classes="sectionLabel" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoverCategory">
                                    <Button Classes="tile" Width="196" Height="74"
                                            Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SearchCategoryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Description}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Label}" FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Classes="muted"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--
                        Collections: ways of slicing the search rather than subjects.
                        Each description says what it actually asks GitHub for, because
                        "Popular on GitHub" could easily read as "RepoDeck recommends",
                        which it is not and must never become.
                    -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="OR BROWSE BY THE KIND OF THING" Classes="sectionLabel" />
                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiscoverCollection">
                                    <Button Classes="tile" Width="212" Height="74"
                                            Command="{Binding $parent[ItemsControl].((vm:DiscoverViewModel)DataContext).SearchCollectionCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Description}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Label}" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RdAccentBrush}" />
                                            <TextBlock Text="{Binding Description}" Classes="muted"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="OR DESCRIBE WHAT YOU WANT" Classes="sectionLabel" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="secondary" Content="Edit videos"
                                    Command="{Binding SearchForCommand}" CommandParameter="video editor" />
                            <Button Classes="secondary" Content="Send files"
                                    Command="{Binding SearchForCommand}" CommandParameter="send files between devices" />
                            <Button Classes="secondary" Content="Music player"
                                    Command="{Binding SearchForCommand}" CommandParameter="music player" />
                            <Button Classes="secondary" Content="Record my screen"
                                    Command="{Binding SearchForCommand}" CommandParameter="screen recorder" />
                            <Button Classes="secondary" Content="Retro games"
                                    Command="{Binding SearchForCommand}" CommandParameter="retro game emulator" />
                            <Button Classes="secondary" Content="Find duplicate files"
                                    Command="{Binding SearchForCommand}" CommandParameter="find duplicate files" />
                            <Button Classes="secondary" Content="Password manager"
                                    Command="{Binding SearchForCommand}" CommandParameter="password manager" />
                            <Button Classes="secondary" Content="Take notes"
                                    Command="{Binding SearchForCommand}" CommandParameter="note taking app" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Classes="inset" MaxWidth="620" HorizontalAlignment="Left">
                        <StackPanel Spacing="6">
                            <TextBlock Text="HOW THIS WORKS" Classes="microLabel" />
                            <TextBlock Classes="secondary"
                                       Text="RepoDeck searches a large collection of free, open software. It reads each project, explains in plain English what it does, works out whether it runs on your computer, and installs the ones it can." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Nothing found -->
            <Border IsVisible="{Binding ShowEmptyState}" VerticalAlignment="Top" Margin="0,40,0,0">
                <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="NOTHING MATCHED" Classes="microLabel"
                               Foreground="{DynamicResource RdCautionBrush}" />
                    <TextBlock Text="Nothing matched that search" Classes="h1" />
                    <TextBlock Classes="body" Foreground="{DynamicResource RdTextSecondaryBrush}"
                               Text="Try fewer words, or loosen the filters. The stars, language and date filters can rule out a lot at once." />
                    <Button Classes="secondary" Content="RESET FILTERS" HorizontalAlignment="Left"
                            Command="{Binding ClearFiltersCommand}" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <ScrollViewer IsVisible="{Binding ShowResults}">
                <StackPanel Spacing="0" Margin="0,0,14,24">

                    <!--
                        Card by default. Three columns where there is room for three, then
                        two, then one - the panel decides from its own width, so the layout
                        follows the window rather than a breakpoint guessed in advance.
                    -->
                    <ListBox Classes="cards"
                             IsVisible="{Binding IsCardView}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             SelectionMode="Single">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResponsiveCardsPanel
                                    MinItemWidth="{DynamicResource RdCardMinWidth}"
                                    MaxColumns="3"
                                    Spacing="{DynamicResource RdCardSpacing}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                                <ContentControl Content="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        Compact: one row per project for somebody who already knows the
                        landscape and wants forty results on screen rather than nine. The
                        same facts in the same order, with the picture reduced to a tile.
                    -->
                    <ListBox Classes="rows"
                             IsVisible="{Binding IsCompactView}"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepositoryCardViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,8">

                                    <Border Grid.Column="0" Width="40" Height="40"
                                            ClipToBounds="True"
                                            CornerRadius="{DynamicResource RdRadiusSmall}"
                                            Margin="0,0,12,0">
                                        <Panel ToolTip.Tip="{Binding KindExplanation}">
                                            <Border Background="{Binding FallbackBrush}"
                                                    IsVisible="{Binding ShowFallback}" />

                                            <!-- The kind mark reads as a silhouette at this
                                                 size, which a letter does not: scanning a
                                                 long list, the shape says more than the
                                                 first character of the name. -->
                                            <controls:KindArtwork Kind="{Binding Kind}"
                                                                  Initial="{Binding FallbackInitial}"
                                                                  Accent="{DynamicResource RdOnAccentBrush}"
                                                                  MarkScale="0.62"
                                                                  Opacity="0.85"
                                                                  IsVisible="{Binding ShowFallback}" />

                                            <Image Source="{Binding Image}"
                                                   IsVisible="{Binding ShowImage}"
                                                   Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FriendlyName}" Classes="body"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{Binding Purpose}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7"
                                                VerticalAlignment="Center" Margin="14,0"
                                                ToolTip.Tip="{Binding InstallabilityExplanation}">
                                        <Ellipse Classes="led"
                                                 Classes.ledOn="{Binding IsReadyToInstall}"
                                                 Classes.ledWarn="{Binding IsDeveloperFocused}"
                                                 Classes.ledBad="{Binding IsNotCompatible}" />
                                        <TextBlock Text="{Binding InstallabilityLabel}" Classes="muted"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Classes="primary"
                                            Content="{Binding PrimaryActionLabel}"
                                            VerticalAlignment="Center"
                                            Command="{Binding ActivateCommand}"
                                            ToolTip.Tip="{Binding PrimaryActionTooltip}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Classes="secondary"
                            Content="SHOW MORE RESULTS"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            IsVisible="{Binding CanLoadMore}"
                            IsEnabled="{Binding !IsLoadingMore}"
                            Command="{Binding LoadMoreCommand}" />

                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                 IsVisible="{Binding IsLoadingMore}" />
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>

    <!--
        Quick Look. Beside the results where there is room for both, and over them where
        there is not - it is the last child, so it draws on top. It never navigates away
        from the search, so comparing candidates does not mean losing your place.
    -->
    <ContentControl Width="380"
                    HorizontalAlignment="Right"
                    Content="{Binding QuickLook}"
                    IsVisible="{Binding QuickLook.ShowPanel, FallbackValue=False}"
                    Grid.Column="{Binding #DiscoverRoot.Bounds.Width,
                                          Converter={x:Static infra:PanelDisplayConverter.Instance}}"
                    Grid.ColumnSpan="{Binding #DiscoverRoot.Bounds.Width,
                                              Converter={x:Static infra:PanelDisplayConverter.Instance},
                                              ConverterParameter=span}" />
    </Grid>
</UserControl>
